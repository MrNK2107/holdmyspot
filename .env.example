# Copy to .env (gitignored). Everything is optional: with nothing set the app uses the
# deterministic PayPal simulator and the fake front-desk AI.

# PAYMENTS=sandbox switches to real PayPal sandbox traffic
PAYMENTS=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# PayPal Agent Toolkit read tools for the owner's agent: unset = function calling,
# mcp = PayPal's MCP server class in-process, off = no toolkit tools
PAYPAL_AGENT_TOOLKIT=
# the studio's IANA time zone (end-of-day attendance review, slot labels); unset = UTC, as the demo
STUDIO_TIMEZONE=
# audit entries kept per workspace (oldest dropped first); unset = 5000
AUDIT_MAX_ENTRIES=

# AI=anthropic switches the front desk to Claude
AI=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

PORT=18080
PUBLIC_URL=
# webhook id from the sandbox app (enables the /api/paypal/webhook endpoint)
PAYPAL_WEBHOOK_ID=

# ISO currency sent to PayPal; unset = USD. Use INR if the sandbox business account is Indian
PAYPAL_CURRENCY=

# Google Gemini (the real front-desk AI): AI defaults to gemini when payments are real and a key is set.
# Put as many free-tier keys as you have in GEMINI_API_KEYS, separated by commas (or new lines); when one is
# rate limited the server switches to the next. GEMINI_API_KEY (a single key) still works and is added to the list.
GEMINI_API_KEYS=
GEMINI_API_KEY=
GEMINI_MODEL=
# CLOCK=demo forces the simulated clock; real payments default to the real clock
CLOCK=
